# Copy to .env and fill in to run MedGuard against a real model provider.
# If no key is set (or MEDGUARD_FAKE=1), MedGuard runs in deterministic
# "fake" mode: no network, canned output. Great for reading the code and for
# reproducing the Chapter 1 post-mortem exactly.

# --- Provider selection ---
MEDGUARD_PROVIDER=openai
MEDGUARD_MODEL=gpt-4o-mini

# --- Credentials (only needed for a real provider) ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Force deterministic offline mode regardless of keys ---
# MEDGUARD_FAKE=1
